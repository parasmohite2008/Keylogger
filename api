export default function handler(req, res) {
    // Only allow POST requests for login submission
    if (req.method !== 'POST') {
        return res.status(405).json({ message: 'Method Not Allowed' });
    }

    const { username, password } = req.body;

    // In a production app, you would fetch the user from a database 
    // and verify the password using a hashing library like bcrypt.
    // For this project, we use a secure server-side check.
    const CORRECT_USERNAME = "admin";
    const CORRECT_PASSWORD = "SuperSecurePassword2026"; 

    if (username === CORRECT_USERNAME && password === CORRECT_PASSWORD) {
        return res.status(200).json({ 
            success: true, 
            message: 'Congratulations, you entered securely!' 
        });
    } else {
        return res.status(401).json({ 
            success: false, 
            message: 'Access Denied. Invalid credentials.' 
        });
    }
}
